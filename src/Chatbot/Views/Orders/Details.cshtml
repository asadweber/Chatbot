@model Application.Dtos.OrderDto
@{
    ViewData["Title"] = "Order Details";

    string BadgeClass(string status) => (status ?? "").ToLower() switch
    {
        "completed" => "badge-status-completed",
        "cancelled" => "badge-status-cancelled",
        _ => "badge-status-pending"
    };
}

<div class="mb-4">
    <a asp-action="Index" class="text-decoration-none text-muted small">&larr; Back to Orders</a>
    <div class="d-flex justify-content-between align-items-start mt-2">
        <div>
            <h1 class="h3 mb-1 fw-semibold">Order #@Model.Id</h1>
            <span class="badge rounded-pill @BadgeClass(Model.Status)">@Model.Status</span>
        </div>
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary px-4">Edit Order</a>
    </div>
</div>

<div class="card shadow-sm border-0 mb-4">
    <div class="card-body p-4">
        <div class="row g-4">
            <div class="col-md-4">
                <div class="text-muted small fw-semibold">Customer</div>
                <div class="fs-5">@Model.CustomerName</div>
            </div>
            <div class="col-md-4">
                <div class="text-muted small fw-semibold">Order Date</div>
                <div class="fs-5">@Model.OrderDate.ToString("MMM d, yyyy HH:mm")</div>
            </div>
            <div class="col-md-4">
                <div class="text-muted small fw-semibold">Total Amount</div>
                <div class="fs-5 fw-semibold text-primary">@Model.TotalAmount.ToString("C")</div>
            </div>
        </div>
    </div>
</div>

<div class="card shadow-sm border-0 mb-4">
    <div class="card-header bg-white border-0 pt-4 px-4">
        <h2 class="h6 fw-semibold mb-0">Order Details</h2>
    </div>
    <div class="card-body p-0">
        <table class="table align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th class="ps-4">Product</th>
                    <th>Qty</th>
                    <th>Unit Price</th>
                    <th class="pe-4 text-end">Total</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var detail in Model.OrderDetails)
                {
                    <tr>
                        <td class="ps-4">@detail.ProductName</td>
                        <td>@detail.OrderQty</td>
                        <td>@detail.UnitPrice.ToString("C")</td>
                        <td class="pe-4 text-end fw-semibold">@detail.Total.ToString("C")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<style>
    .badge-status-pending { background-color: #fff3cd; color: #664d03; }
    .badge-status-completed { background-color: #d1e7dd; color: #0f5132; }
    .badge-status-cancelled { background-color: #f8d7da; color: #842029; }
</style>
