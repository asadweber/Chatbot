@model List<Application.Dtos.OrderDto>
@{
    ViewData["Title"] = "Semantic Order Search";
    var query = ViewBag.Query as string ?? "";
}

<div class="orders-hero d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h3 mb-1 fw-bold text-white">Semantic Order Search</h1>
        <p class="text-white-50 mb-0">Ask natural-language questions about orders</p>
    </div>
    <a asp-action="Index" class="btn btn-hero px-4 fw-semibold">Back to Orders</a>
</div>

<div class="card shadow border-0 orders-card mb-4">
    <div class="card-body">
        <form asp-action="Search" method="post" class="d-flex gap-2">
            @Html.AntiForgeryToken()
            <input type="text" name="query" value="@query" class="form-control"
                   placeholder="e.g. Find orders from customers" />
            <button type="submit" class="btn btn-hero px-4 fw-semibold">Search</button>
        </form>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(query))
{
    <div class="card shadow border-0 orders-card">
        <div class="card-body p-0">
            @if (Model is { Count: > 0 })
            {
                <table class="table table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Order ID</th>
                            <th>Customer</th>
                            <th>Order Date</th>
                            <th>Total Amount</th>
                            <th>Status</th>
                            <th>Products</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var order in Model)
                        {
                            <tr>
                                <td>@order.Id</td>
                                <td>@order.CustomerName</td>
                                <td>@order.OrderDate.ToString("yyyy-MM-dd")</td>
                                <td>$@order.TotalAmount.ToString("F2")</td>
                                <td>@order.Status</td>
                                <td>@string.Join(", ", order.OrderDetails.Select(d => $"{d.ProductName} x{d.OrderQty}"))</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <p class="p-3 mb-0 text-muted">No matching orders found.</p>
            }
        </div>
    </div>
}
