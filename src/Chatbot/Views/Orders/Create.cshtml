@model Application.Dtos.OrderDto
@{
    ViewData["Title"] = "Create Order";
}

<div class="orders-hero mb-4">
    <a asp-action="Index" class="text-decoration-none text-white-50 small">&larr; Back to Orders</a>
    <h1 class="h3 mt-2 mb-1 fw-bold text-white">New Order</h1>
    <p class="text-white-50 mb-0">Create an order and add product lines</p>
</div>

<form asp-action="Create" method="post" id="orderForm">
    <div class="card shadow-sm border-0 mb-4 accent-card accent-gold">
        <div class="card-header bg-white border-0 pt-4 px-4">
            <h2 class="h6 fw-bold mb-0 text-gold">Order Information</h2>
        </div>
        <div class="card-body px-4 pb-4">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="row g-3">
                <div class="col-md-4">
                    <label asp-for="CustomerId" class="form-label small fw-semibold text-muted">Customer</label>
                    @await Component.InvokeAsync("CustomerSelect")
                    <span asp-validation-for="CustomerId" class="text-danger"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="OrderDate" class="form-label small fw-semibold text-muted">Order Date</label>
                    <input asp-for="OrderDate" type="datetime-local" class="form-control" />
                    <span asp-validation-for="OrderDate" class="text-danger"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="Status" class="form-label small fw-semibold text-muted">Status</label>
                    <input asp-for="Status" class="form-control" />
                </div>
            </div>
        </div>
    </div>

    <div class="card shadow-sm border-0 mb-4 accent-card accent-amber">
        <div class="card-header bg-white border-0 pt-4 px-4 d-flex justify-content-between align-items-center">
            <h2 class="h6 fw-bold mb-0 text-amber">Order Details</h2>
            <button type="button" id="addRowBtn" class="btn btn-sm btn-gradient-outline">+ Add Line</button>
        </div>
        <div class="card-body p-0">
            <table class="table table-sm align-middle mb-0" id="orderDetailsTable">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4">Product</th>
                        <th style="width:100px">Qty</th>
                        <th style="width:130px">Unit Price</th>
                        <th style="width:130px">Total</th>
                        <th style="width:50px"></th>
                    </tr>
                </thead>
                <tbody></tbody>
            </table>
        </div>
        <div class="card-footer bg-white border-0 px-4 py-3 d-flex justify-content-end align-items-center">
            <span class="text-muted small fw-semibold me-3">Total Amount</span>
            <input id="totalAmount" class="form-control form-control-sm text-end fw-bold total-amount-input" style="width:150px" readonly />
        </div>
    </div>

    <div class="d-flex gap-2">
        <button type="submit" class="btn btn-gradient px-4 fw-semibold">Create Order</button>
        <a asp-action="Index" class="btn btn-outline-secondary px-4">Cancel</a>
    </div>
</form>

@section Scripts {
    <script src="~/lib/select2/js/select2.full.min.js"></script>
    <script>
        window.addEventListener('load', function () {
            var rowIndex = 0;

            function recalcRow(row) {
                var qty = parseFloat(row.find('.qty-input').val()) || 0;
                var price = parseFloat(row.find('.price-input').val()) || 0;
                var total = qty * price;
                row.find('.total-cell').text(total.toFixed(2));
                row.find('.total-input').val(total.toFixed(2));
                recalcTotalAmount();
            }

            function recalcTotalAmount() {
                var sum = 0;
                $('#orderDetailsTable .total-input').each(function () {
                    sum += parseFloat($(this).val()) || 0;
                });
                $('#totalAmount').val(sum.toFixed(2));
            }

            function addRow() {
                var i = rowIndex++;
                var selectId = 'productSelect_' + i;

                var row = $(
                    '<tr>' +
                    '<td class="ps-4"><select id="' + selectId + '" class="form-control product-select" name="OrderDetails[' + i + '].ProductId"></select></td>' +
                    '<td><input type="number" min="1" value="1" class="form-control form-control-sm qty-input" name="OrderDetails[' + i + '].OrderQty" /></td>' +
                    '<td><input type="number" step="0.01" class="form-control form-control-sm price-input" name="OrderDetails[' + i + '].UnitPrice" /></td>' +
                    '<td><span class="total-cell fw-semibold">0.00</span><input type="hidden" class="total-input" name="OrderDetails[' + i + '].Total" value="0" /></td>' +
                    '<td><button type="button" class="btn btn-sm btn-outline-danger remove-row-btn">&times;</button></td>' +
                    '</tr>'
                );

                $('#orderDetailsTable tbody').append(row);

                row.find('.product-select').select2({
                    theme: 'bootstrap',
                    width: '100%',
                    placeholder: 'Select a product',
                    ajax: {
                        url: '@Url.Action("Search", "Products")',
                        dataType: 'json',
                        delay: 250,
                        data: function (params) {
                            return { q: params.term, page: params.page || 1 };
                        },
                        processResults: function (data, params) {
                            params.page = params.page || 1;
                            return { results: data.results, pagination: data.pagination };
                        },
                        cache: true
                    },
                    minimumInputLength: 0
                });

                row.find('.product-select').on('select2:select', function (e) {
                    var price = e.params.data.price || 0;
                    row.find('.price-input').val(price);
                    recalcRow(row);
                });

                row.find('.qty-input, .price-input').on('input', function () {
                    recalcRow(row);
                });

                row.find('.remove-row-btn').on('click', function () {
                    row.remove();
                    recalcTotalAmount();
                });
            }

            $('#addRowBtn').on('click', addRow);
            addRow();
        });
    </script>
}
