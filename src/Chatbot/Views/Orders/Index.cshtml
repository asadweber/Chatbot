@{
    ViewData["Title"] = "Orders";
}

<div class="orders-hero d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h3 mb-1 fw-bold text-white">Orders</h1>
        <p class="text-white-50 mb-0">Manage customer orders and line items</p>
    </div>
    <a asp-action="Create" class="btn btn-hero px-4 fw-semibold">+ New Order</a>
</div>

<link rel="stylesheet" href="~/lib/datatables/dataTables.bootstrap5.min.css" />

<div class="card shadow border-0 orders-card">
    <div class="card-body p-0">
        <table id="ordersTable" class="table table-hover align-middle mb-0" style="width:100%">
            <thead>
                <tr>
                    <th>Customer</th>
                    <th>Order Date</th>
                    <th>Total Amount</th>
                    <th>Status</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
        </table>
    </div>
</div>

<style>
    .orders-hero {
        background: linear-gradient(135deg, #7b2ff7 0%, #f107a3 100%);
        border-radius: 1rem;
        padding: 1.75rem 2rem;
        box-shadow: 0 10px 25px rgba(123, 47, 247, 0.25);
    }
    .btn-hero {
        background: #fff;
        color: #7b2ff7;
        border: none;
        transition: transform .15s ease, box-shadow .15s ease;
    }
    .btn-hero:hover { transform: translateY(-1px); box-shadow: 0 6px 14px rgba(0,0,0,.15); color: #7b2ff7; }
    .orders-card thead { background: linear-gradient(90deg, #667eea 0%, #764ba2 100%); }
    .orders-card thead th { color: #fff; border: none; padding: 0.9rem 1rem; }
    #ordersTable td { padding: 0.85rem 1rem; }
    .badge-status-pending { background: linear-gradient(90deg,#f6d365,#fda085); color: #7a4a00; }
    .badge-status-completed { background: linear-gradient(90deg,#43e97b,#38f9d7); color: #05512f; }
    .badge-status-cancelled { background: linear-gradient(90deg,#f857a6,#ff5858); color: #fff; }
    #ordersTable .badge { padding: 0.5em 0.9em; font-weight: 600; }
</style>

@section Scripts {
    <script src="~/lib/datatables/jquery.dataTables.min.js"></script>
    <script src="~/lib/datatables/dataTables.bootstrap5.min.js"></script>
    <script>
        $(function () {
            function statusBadgeClass(status) {
                switch ((status || '').toLowerCase()) {
                    case 'completed': return 'badge-status-completed';
                    case 'cancelled': return 'badge-status-cancelled';
                    default: return 'badge-status-pending';
                }
            }

            $('#ordersTable').DataTable({
                serverSide: true,
                processing: true,
                ajax: {
                    url: '@Url.Action("IndexData", "Orders")',
                    type: 'POST'
                },
                columns: [
                    { data: 'customerName', name: 'CustomerName' },
                    {
                        data: 'orderDate',
                        name: 'OrderDate',
                        render: function (data) {
                            return data ? new Date(data).toISOString().replace('T', ' ').substring(0, 19) : '';
                        }
                    },
                    {
                        data: 'totalAmount',
                        name: 'TotalAmount',
                        render: function (data) {
                            return '$' + parseFloat(data || 0).toFixed(2);
                        }
                    },
                    {
                        data: 'status',
                        name: 'Status',
                        render: function (data) {
                            return '<span class="badge rounded-pill ' + statusBadgeClass(data) + '">' + data + '</span>';
                        }
                    },
                    {
                        data: 'id',
                        orderable: false,
                        searchable: false,
                        className: 'text-end',
                        render: function (id) {
                            return '<a href="/Orders/Details/' + id + '" class="btn btn-sm btn-outline-secondary me-1">Details</a>' +
                                   '<a href="/Orders/Edit/' + id + '" class="btn btn-sm btn-outline-primary me-1">Edit</a>' +
                                   '<a href="/Orders/Delete/' + id + '" class="btn btn-sm btn-outline-danger">Delete</a>';
                        }
                    }
                ]
            });
        });
    </script>
}
