@{
    ViewData["Title"] = "Support Desk";
}

<div class="orders-hero d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h3 mb-1 fw-bold text-white">Support Desk</h1>
        <p class="text-white-50 mb-0">Ask questions about orders in plain language</p>
    </div>
</div>

<div class="card shadow border-0 orders-card">
    <div class="card-body">
        <div id="chatLog" class="mb-3" style="max-height: 55vh; overflow-y: auto;"></div>

        <form id="chatForm" class="d-flex gap-2">
            @Html.AntiForgeryToken()
            <input type="text" id="questionInput" class="form-control"
                   placeholder="e.g. Which customers placed large orders recently?" autocomplete="off" />
            <button type="submit" class="btn btn-hero px-4 fw-semibold">Ask</button>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            const log = document.getElementById('chatLog');
            const form = document.getElementById('chatForm');
            const input = document.getElementById('questionInput');
            const token = document.querySelector('input[name="__RequestVerificationToken"]').value;
            const history = [];

            function appendMessage(role, text) {
                const wrap = document.createElement('div');
                wrap.className = 'mb-2';

                const strong = document.createElement('strong');
                strong.textContent = (role === 'user' ? 'You' : 'Support Desk') + ':';
                wrap.appendChild(strong);
                wrap.appendChild(document.createTextNode(' '));

                const span = document.createElement('span');
                span.textContent = text;
                wrap.appendChild(span);

                log.appendChild(wrap);
                log.scrollTop = log.scrollHeight;
            }

            function appendOrders(orders) {
                if (!orders || !orders.length) return;
                const wrap = document.createElement('div');
                wrap.className = 'mb-3 small text-muted';
                wrap.textContent = 'Related orders: ' + orders.map(o => '#' + o.id + ' (' + o.customerName + ')').join(', ');
                log.appendChild(wrap);
                log.scrollTop = log.scrollHeight;
            }

            form.addEventListener('submit', async function (e) {
                e.preventDefault();
                const question = input.value.trim();
                if (!question) return;

                appendMessage('user', question);
                input.value = '';
                input.disabled = true;

                try {
                    const res = await fetch('@Url.Action("Ask", "SupportDesk")', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'RequestVerificationToken': token
                        },
                        body: JSON.stringify({ question: question, history: history })
                    });

                    if (!res.ok) {
                        appendMessage('assistant', 'Sorry, something went wrong.');
                        return;
                    }

                    const data = await res.json();
                    appendMessage('assistant', data.answer);
                    appendOrders(data.orders);

                    history.push({ role: 'user', content: question });
                    history.push({ role: 'assistant', content: data.answer });
                } finally {
                    input.disabled = false;
                    input.focus();
                }
            });
        })();
    </script>
}
