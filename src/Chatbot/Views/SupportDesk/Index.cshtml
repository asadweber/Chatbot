@{
    ViewData["Title"] = "Support Desk";
}

<div class="orders-hero d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h3 mb-1 fw-bold text-white">Support Desk</h1>
        <p class="text-white-50 mb-0">Ask questions about orders in plain language</p>
    </div>
</div>

<div id="startCard" class="card shadow border-0 orders-card mb-3">
    <div class="card-body">
        <h2 class="h6 fw-semibold mb-3">Start a session</h2>
        <form id="startForm" class="d-flex gap-2">
            <input type="text" id="orderIdInput" class="form-control" style="max-width: 220px;"
                   placeholder="Order Id" autocomplete="off" inputmode="numeric" pattern="\d+" required />
            <button type="submit" class="btn btn-hero px-4 fw-semibold">Start session</button>
        </form>
        <p class="text-muted small mt-2 mb-0">Enter the order id to start the session.</p>
    </div>
</div>

<div id="sessionArea" class="d-none">
    <div class="card shadow border-0 orders-card mb-3">
        <div class="card-body">
            <h2 class="h6 fw-semibold mb-3">Frequently asked questions</h2>
            <div id="faqChips" class="d-flex flex-wrap gap-2">
                <span class="text-muted small">Loading FAQs...</span>
            </div>
        </div>
    </div>

    <div class="card shadow border-0 orders-card">
        <div class="card-body">
            <div id="chatLog" class="mb-3" style="max-height: 55vh; overflow-y: auto;"></div>

            <form id="chatForm" class="d-flex gap-2">
                @Html.AntiForgeryToken()
                <input type="text" id="questionInput" class="form-control"
                       placeholder="" autocomplete="off" />
                <button type="submit" class="btn btn-hero px-4 fw-semibold">Ask</button>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            const startCard = document.getElementById('startCard');
            const startForm = document.getElementById('startForm');
            const orderIdInput = document.getElementById('orderIdInput');
            const sessionArea = document.getElementById('sessionArea');
            const log = document.getElementById('chatLog');
            const form = document.getElementById('chatForm');
            const input = document.getElementById('questionInput');
            const faqChips = document.getElementById('faqChips');
            const token = document.querySelector('input[name="__RequestVerificationToken"]').value;
            const history = [];

            function askQuestion(question) {
                input.value = question;
                form.requestSubmit();
            }

            let sessionOrderId = null;

            startForm.addEventListener('submit', function (e) {
                e.preventDefault();
                const orderId = orderIdInput.value.trim();
                if (!orderId) {
                    orderIdInput.reportValidity();
                    return;
                }

                sessionOrderId = orderId;
                startCard.classList.add('d-none');
                sessionArea.classList.remove('d-none');
                loadFaqs();

                askQuestion('What is the customer detail of order #' + orderId + '?');
            });

            function addFaqChip(question) {
                const btn = document.createElement('button');
                btn.type = 'button';
                btn.className = 'btn btn-outline-secondary btn-sm';
                btn.textContent = question;
                btn.addEventListener('click', function () { askQuestion(question); });
                faqChips.appendChild(btn);
            }

            async function loadFaqs() {
                faqChips.innerHTML = '';

                // Session-scoped: re-asks the current order's status rather
                // than a static answer, so it must be added client-side
                // instead of coming from the static FAQ list.
                if (sessionOrderId) {
                    addFaqChip('What is the customer detail of order #' + sessionOrderId + '?');
                }

                try {
                    const res = await fetch('@Url.Action("Faqs", "SupportDesk")');
                    if (!res.ok) throw new Error('FAQ request failed');
                    const faqs = await res.json();
                    faqs.forEach(function (faq) { addFaqChip(faq.question); });
                } catch {
                    if (!sessionOrderId) faqChips.textContent = 'Couldn\'t load FAQs.';
                }
            }

            function appendMessage(role, text) {
                const wrap = document.createElement('div');
                wrap.className = 'mb-2';

                const strong = document.createElement('strong');
                strong.textContent = (role === 'user' ? 'You' : 'Support Desk') + ':';
                wrap.appendChild(strong);
                wrap.appendChild(document.createTextNode(' '));

                const span = document.createElement('span');
                span.textContent = text;
                wrap.appendChild(span);

                log.appendChild(wrap);
                log.scrollTop = log.scrollHeight;
            }

            form.addEventListener('submit', async function (e) {
                e.preventDefault();
                const question = input.value.trim();
                if (!question) return;

                appendMessage('user', question);
                input.value = '';
                input.disabled = true;

                try {
                    const res = await fetch('@Url.Action("Ask", "SupportDesk")', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'RequestVerificationToken': token
                        },
                        body: JSON.stringify({ question: question, history: history })
                    });

                    if (!res.ok) {
                        appendMessage('assistant', 'Sorry, something went wrong.');
                        return;
                    }

                    const data = await res.json();
                    appendMessage('assistant', data.answer);

                    history.push({ role: 'user', content: question });
                    history.push({ role: 'assistant', content: data.answer });
                } finally {
                    input.disabled = false;
                    input.focus();
                }
            });
        })();
    </script>
}
